# ⚠️ Copiá este archivo como .env y completá con tus claves reales
# ⚠️ El archivo .env NUNCA se sube a GitHub (está en .gitignore)
# ⚠️ En Render, estas variables se ponen en el panel Environment

# ===== SUPABASE (base de datos + autenticación) =====
# Obtenelas en: supabase.com → tu proyecto → Project Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon-aqui

# ===== GROQ (inteligencia artificial de Dimon) =====
# Obtenela en: console.groq.com → API Keys
GROQ_API_KEY=tu-clave-de-groq-aqui

# ===== SERVIDOR =====
PORT=3001
NODE_ENV=production
